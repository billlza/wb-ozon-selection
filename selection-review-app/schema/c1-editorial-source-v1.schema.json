{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1-editorial-source-v1",
  "title": "主人确认的C1受控修订来源",
  "description": "只保存可复验的原失败来源及主人确认；不表示模型回执成功或生产授权。跨字段一致性由领域合同复验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundle",
    "ownerConfirmation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "c1-editorial-source-v1"
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "receipt",
        "sourceJob",
        "correctionPlan"
      ],
      "properties": {
        "request": {
          "$ref": "c1-ai-draft-request-v1.schema.json"
        },
        "receipt": {
          "$ref": "c1-ai-draft-receipt-v1.schema.json"
        },
