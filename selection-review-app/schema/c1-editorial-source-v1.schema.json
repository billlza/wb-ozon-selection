                "skuPackageId",
                "revision",
                "workerId",
                "leaseId",
                "externalRequestRef",
                "externalRequestState",
                "payloadKind",
                "payload",
                "payloadFingerprint",
                "applicationDisposition",
                "recordedAt"
              ],
