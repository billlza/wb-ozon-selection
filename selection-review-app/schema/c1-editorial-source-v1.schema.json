                "schemaVersion": {
                  "const": "software-job-result-envelope-v1"
                },
                "resultRef": {
                  "$ref": "software-job-admission-v1.schema.json#/$defs/strictRef"
                },
                "jobId": {
                  "$ref": "software-job-admission-v1.schema.json#/$defs/strictRef"
                },
                "jobType": {
                  "$ref": "software-job-admission-v1.schema.json#/$defs/strictRef",
                  "not": {
                    "enum": [
                      "d_production_execution",
                      "e_independent_readback"
                    ]
                  }
                },
                "candidateId": {
                  "$ref": "software-job-admission-v1.schema.json#/$defs/strictRef"
                },
                "skuPackageId": {
                  "$ref": "software-job-admission-v1.schema.json#/$defs/strictRef"
                },
