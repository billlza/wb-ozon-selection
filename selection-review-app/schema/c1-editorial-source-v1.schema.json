            "jobId",
            "candidateId",
            "skuPackageId",
            "revision",
            "jobType",
            "status",
            "attempt",
            "externalRequestState",
            "failureClass",
            "progressRef",
            "resultRef",
            "scopeBinding",
            "admissionDecision",
            "externalRequestRef",
            "workerId",
            "leaseId",
            "startedAt",
            "completedAt",
            "resultEnvelope"
          ],
          "properties": {
            "schemaVersion": {
              "const": "c1-editorial-rejected-job-v1"
            },
            "jobId": {
              "$ref": "software-job-v1.schema.json#/properties/jobId"
            },
            "candidateId": {
              "$ref": "software-job-v1.schema.json#/properties/candidateId"
            },
            "skuPackageId": {
              "$ref": "software-job-v1.schema.json#/properties/skuPackageId"
            },
            "revision": {
              "$ref": "software-job-v1.schema.json#/properties/revision"
            },
            "jobType": {
              "const": "c1_ai_draft"
            },
            "status": {
              "const": "failed"
            },
            "attempt": {
              "const": 1
            },
            "externalRequestState": {
              "const": "succeeded"
            },
            "failureClass": {
              "const": "C1_AI_GATEWAY_RECEIPT_REJECTED"
            },
            "progressRef": {
              "$ref": "software-job-v1.schema.json#/properties/progressRef"
            },
            "resultRef": {
              "$ref": "software-job-v1.schema.json#/properties/resultRef"
            },
            "scopeBinding": {
              "$ref": "software-job-v1.schema.json#/$defs/c1AiDraftScopeBinding"
            },
            "admissionDecision": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "jobId",
                "candidateId",
                "skuPackageId",
                "revision",
                "jobType",
                "authorizationRef",
                "credentialAlias",
                "authorizationFingerprint",
                "credentialBindingFingerprint"
              ],
              "properties": {
                "schemaVersion": {
                  "const": "software-job-admission-v1"
                },
                "jobId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "candidateId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "skuPackageId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "jobType": {
                  "const": "c1_ai_draft"
                },
                "authorizationRef": {
                  "$ref": "c1-ai-authorized-execution-v1#/$defs/c1OpaqueAuthorizationId"
                },
                "credentialAlias": {
