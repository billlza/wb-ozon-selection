              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceOutputFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceSoftwareJobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 62,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "originalText",
                  "originalFactRefs",
                  "originalAssertions",
                  "correctedText",
                  "factPaths",
                  "explanation",
                  "sourceRefs"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "originalText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6000
                  },
                  "originalFactRefs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 60,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "originalAssertions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 60,
                    "items": {
                      "$ref": "c1-ai-draft-receipt-v1.schema.json#/$defs/citedText/properties/assertions/items"
                    }
                  },
                  "correctedText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6000
                  },
                  "factPaths": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 60,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "uniqueItems": true
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "sourceRefs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 60,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "ownerConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "candidateId",
        "skuPackageId",
        "sourceCandidateRevision",
        "resultCandidateRevision",
        "sourceSkuRevision",
        "resultSkuRevision",
        "editorialVersionId",
        "outputFingerprint",
        "confirmedByUserId",
        "actorType",
        "role",
        "source",
        "confirmedAt",
        "productionAuthorizationGranted"
      ],
      "properties": {
        "schemaVersion": {
          "const": "c1-editorial-owner-confirmation-v1"
        },
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "skuPackageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sourceCandidateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "resultCandidateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSkuRevision": {
          "type": "integer",
          "minimum": 0
        },
        "resultSkuRevision": {
          "type": "integer",
          "minimum": 0
        },
        "editorialVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "outputFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirmedByUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "actorType": {
          "const": "human"
        },
        "role": {
          "const": "owner"
        },
        "source": {
          "const": "authenticated_identity_provider"
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "productionAuthorizationGranted": {
          "const": false
        }
      }
    }
  },
