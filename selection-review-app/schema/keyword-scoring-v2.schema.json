{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keyword-scoring-v2",
  "title": "Keyword scoring v2 evidence contract",
  "type": "object",
  "required": [
    "scoringVersion",
    "weights",
    "groupLimits",
    "componentEvidence"
  ],
  "properties": {
    "scoringVersion": {
      "const": "keyword-scoring-v2"
    },
    "weights": {
      "const": {
        "semanticMatch": 35,
        "searchDemand": 10,
        "addToCartConversion": 10,
        "competitorConsensus": 12,
        "titleDensity": 7,
        "competitorCount": 7,
        "searchGrowth": 7,
        "returnCancelHealth": 5,
        "sourceTrust": 7
      }
    },
    "groupLimits": {
      "const": {
        "title_keywords": {
          "min": 1,
          "max": 5
        },
        "attribute_and_tag_keywords": {
          "min": 0,
          "max": 12
        },
        "description_long_tail": {
          "min": 0,
          "max": 20
        }
      }
    },
    "componentEvidence": {
      "type": "object",
      "required": [
        "value",
        "rawValue",
        "raw",
        "normalizationRule",
        "conversionRule",
        "evidenceRef",
        "observedAt",
        "period"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "rawValue": {},
        "raw": {
          "type": [
            "object",
            "null"
          ]
        },
        "normalizationRule": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversionRule": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "rawValue": {
                    "type": "number"
                  }
                },
                "required": [
                  "rawValue"
                ]
              },
              {
                "properties": {
                  "raw": {
                    "type": "object",
                    "minProperties": 1
                  }
                },
                "required": [
                  "raw"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "descriptionGate": {
      "type": "object",
      "required": [
        "approved",
        "evidenceRef",
        "reason"
      ],
      "properties": {
        "approved": {
          "const": true
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rejectedRecord": {
      "type": "object",
      "required": [
        "keyword",
        "matchType",
        "sourceRefs",
        "factRefs",
        "reason",
        "score",
        "confidence"
      ],
      "properties": {
        "keyword": {
          "type": "string",
          "minLength": 1
        },
        "matchType": {
          "enum": [
            "target_fact",
            "exact_match",
            "substitute",
            "multi_seed"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "factRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
