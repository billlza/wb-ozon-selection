{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-record-v1.1",
  "title": "单SKU平台草稿生产记录 v1.1",
  "$defs": {
    "readbackExpectation": {
      "description": "The v1 branch is immutable historical interpretation only. New execution requires v2/free_stock.",
      "oneOf": [
        {
          "$ref": "#/$defs/readbackExpectationV1"
        },
        {
          "$ref": "#/$defs/readbackExpectationV2"
        }
      ]
    },
    "readbackExpectationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "media",
        "warehouseId",
        "stockBasis"
      ],
      "properties": {
        "schemaVersion": {
          "const": "production-readback-expectation-v1"
        },
        "warehouseId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "stockBasis": {
          "const": "present_minus_reserved"
        },
        "media": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetId",
              "order",
              "sha256",
              "submittedUrl"
            ],
            "properties": {
              "assetId": {
                "$ref": "c2-asset-lifecycle-v1.1#/$defs/canonicalFrozenRef"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "submittedUrl": {
                "$ref": "c2-asset-lifecycle-v1.1#/$defs/canonicalStableHttpsAssetRef"
              }
            }
          }
        }
      }
    },
    "readbackExpectationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "media",
        "warehouseId",
        "stockBasis"
      ],
      "properties": {
        "schemaVersion": {
          "const": "production-readback-expectation-v2"
        },
        "warehouseId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "stockBasis": {
          "const": "free_stock"
        },
        "media": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetId",
              "order",
              "sha256",
              "submittedUrl"
            ],
            "properties": {
              "assetId": {
                "$ref": "c2-asset-lifecycle-v1.1#/$defs/canonicalFrozenRef"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "submittedUrl": {
                "$ref": "c2-asset-lifecycle-v1.1#/$defs/canonicalStableHttpsAssetRef"
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "productionRecordId",
    "executionMode",
    "sourceProductionPlanId",
    "sourceProductionPlanFingerprint",
    "sourceAuthorizationId",
    "sourceAuthorizationFingerprint",
    "platform",
    "store",
    "skuPackageId",
    "supplierSkuId",
    "platformProductId",
    "platformOfferId",
    "status",
    "writtenFields",
    "platformEvidenceRef",
    "createdAt",
    "businessStateEffect",
    "batchSize",
    "published",
    "activated",
    "advertisingOpened",
    "inventoryModified",
    "stockWritten",
    "imagesUploaded",
    "finalUploadAssetIds",
    "mainImageAssetId",
    "independentReadbackVerified",
    "platformWriteEvidenceRef",
    "platformReadbackEvidenceRef"
  ],
  "properties": {
    "readbackExpectation": {
      "$ref": "#/$defs/readbackExpectation"
    },
    "schemaVersion": {
      "const": "production-record-v1.1"
    },
    "productionRecordId": {
      "type": "string",
      "minLength": 1
    },
    "executionMode": {
      "enum": [
        "single_sku_draft_only",
        "single_sku_create_and_moderate",
        "single_sku_seller_api"
      ]
    },
    "sourceProductionPlanId": {
      "type": "string",
      "minLength": 1
    },
    "sourceProductionPlanFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceAuthorizationId": {
      "type": "string",
      "minLength": 1
    },
    "sourceAuthorizationFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "store": {
      "type": "string",
      "minLength": 1
    },
    "skuPackageId": {
      "type": "string",
      "minLength": 1
    },
    "supplierSkuId": {
      "type": "string",
      "minLength": 1
    },
    "platformProductId": {
      "type": "string",
      "minLength": 1
    },
    "platformOfferId": {
      "type": [
        "string",
        "null"
      ]
    },
    "merchantSku": {
      "type": "string",
      "minLength": 1
    },
    "requestReceiptRef": {
      "type": "string",
      "minLength": 1
    },
    "inventoryReceiptRef": {
      "type": "string",
      "minLength": 1
    },
    "executionKey": {
      "type": "string",
      "minLength": 1
    },
    "expectedPrice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "const": "CNY"
        }
      }
    },
    "expectedStock": {
      "type": "integer",
      "minimum": 0
    },
    "expectedImageCount": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "validation_or_moderation"
      ],
      "description": "D执行范围与提交阶段的历史记录；当前平台状态读取独立平台观察。"
    },
    "writtenFields": {
      "type": "array",
      "minItems": 6,
      "maxItems": 7,
      "items": {
        "type": "string"
      }
    },
    "platformEvidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "businessStateEffect": {
      "enum": [
        "D_draft_created",
        "D_created_entered_validation_moderation"
      ],
      "description": "D执行范围与提交阶段的历史记录；当前平台状态读取独立平台观察。"
    },
    "batchSize": {
      "const": 1
    },
    "published": {
      "const": false,
      "description": "本轮受控执行是否发送对应独立操作；不表示当前平台销售状态。"
    },
    "activated": {
      "const": false,
      "description": "本轮受控执行是否发送对应独立操作；不表示当前平台销售状态。"
    },
    "advertisingOpened": {
      "const": false,
      "description": "本轮受控执行是否发送对应独立操作；不表示当前平台销售状态。"
    },
    "inventoryModified": {
      "type": "boolean"
    },
    "stockWritten": {
      "type": [
        "integer",
        "null"
      ]
    },
    "imagesUploaded": {
      "type": "integer",
      "minimum": 1
    },
    "finalUploadAssetIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mainImageAssetId": {
      "type": "string",
      "minLength": 1
    },
    "independentReadbackVerified": {
      "const": true
    },
    "platformWriteEvidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "platformReadbackEvidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "storeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableStoreId",
        "platformStoreId",
        "mappingVersion"
      ],
      "properties": {
        "stableStoreId": {
          "type": "string",
          "minLength": 1
        },
        "platformStoreId": {
          "type": "string",
          "minLength": 1
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "warehouseRef": {
      "type": "string",
      "minLength": 1
    },
    "credentialAlias": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionMode": {
            "const": "single_sku_seller_api"
          }
        },
        "required": [
          "executionMode"
        ]
      },
      "then": {
        "required": [
          "merchantSku",
          "requestReceiptRef",
          "inventoryReceiptRef",
          "executionKey",
          "expectedPrice",
          "expectedStock",
          "expectedImageCount",
          "storeRef",
          "warehouseRef",
          "credentialAlias"
        ],
        "properties": {
          "status": {
            "const": "validation_or_moderation"
          },
          "businessStateEffect": {
            "const": "D_created_entered_validation_moderation"
          },
          "inventoryModified": {
            "const": true
          },
          "stockWritten": {
            "type": "integer",
            "minimum": 0
          },
          "merchantSku": {
            "$ref": "#/properties/merchantSku"
          },
          "requestReceiptRef": {
            "$ref": "#/properties/requestReceiptRef"
          },
          "inventoryReceiptRef": {
            "$ref": "#/properties/inventoryReceiptRef"
          },
          "executionKey": {
            "$ref": "#/properties/executionKey"
          },
          "expectedPrice": {
            "$ref": "#/properties/expectedPrice"
          },
          "expectedStock": {
            "$ref": "#/properties/expectedStock"
          },
          "expectedImageCount": {
            "$ref": "#/properties/expectedImageCount"
          },
          "storeRef": {
            "$ref": "#/properties/storeRef"
          },
          "warehouseRef": {
            "$ref": "#/properties/warehouseRef"
          },
          "credentialAlias": {
            "$ref": "#/properties/credentialAlias"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
