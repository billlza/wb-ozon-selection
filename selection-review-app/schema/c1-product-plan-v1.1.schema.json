{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1-product-plan-v1.1",
  "title": "C1商品方案输入包 v1.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "c1PlanId",
    "status",
    "createdAt",
    "inputRefs",
    "identity",
    "inputSnapshots",
    "externalAccesses",
    "profitRecalculated",
    "skuReplaced",
    "finalSeo",
    "finalAttributes",
    "complianceDecision",
    "generatedAssets",
    "productionPayload",
    "factVerificationVersion",
    "factsVerifiedAt",
    "exactSkuVerification",
    "productAttributes",
    "platformCategory",
    "schemaSnapshot",
    "batteryAssessment",
    "categoryRestrictions",
    "platformCompliance",
    "seoTitleDraft",
    "descriptionDraft",
    "bulletPointsDraft",
    "searchKeywordsDraft",
    "seoEvidenceLayer",
    "contractVersion",
    "revisionRefs",
    "frozenInputRefs",
    "schemaSnapshotRef",
    "draftOnlySeo",
    "keywordEvidenceRefs",
    "unknownManifest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "c1-product-plan-v1.1"
    },
    "c1PlanId": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c1PlanId",
        "historyRef"
      ],
      "properties": {
        "c1PlanId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "historyRef": {
          "$ref": "#/$defs/canonicalFrozenRef"
        }
      }
    },
    "status": {
      "enum": [
        "inputs_ready",
        "facts_checked",
        "seo_draft_ready"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "inputRefs": {
      "type": "object",
      "required": [
        "salesSnapshotId",
        "selectedSupplySnapshotId",
        "profitModelVersion",
        "platformSchemaEvidenceId"
      ],
      "properties": {
        "salesSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "selectedSupplySnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "profitModelVersion": {
          "type": "string",
          "pattern": "^profit-v[1-9][0-9]*$"
        },
        "platformSchemaEvidenceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "parentOpportunityId",
        "skuPackageId",
        "supplierOptionId",
        "supplierSkuId",
        "variantKey",
        "targetPlatform",
        "targetStore"
      ],
      "properties": {
        "parentOpportunityId": {
          "type": "string",
          "minLength": 1
        },
        "skuPackageId": {
          "type": "string",
          "minLength": 1
        },
        "supplierOptionId": {
          "type": "string",
          "minLength": 1
        },
        "supplierSkuId": {
          "type": "string",
          "minLength": 1
        },
        "variantKey": {
          "type": "string",
          "minLength": 1
        },
        "targetPlatform": {
          "type": "string",
          "minLength": 1
        },
        "targetStore": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "inputSnapshots": {
      "type": "object",
      "required": [
        "salesSnapshot",
        "confirmedSupplierSkuSnapshot",
        "profitModel",
        "platformSchemaRules"
      ],
      "properties": {
        "salesSnapshot": {
          "type": "object"
        },
        "confirmedSupplierSkuSnapshot": {
          "type": "object"
        },
        "profitModel": {
          "type": "object"
        },
        "platformSchemaRules": {
          "type": "object"
        },
        "skuRightsReview": {
          "anyOf": [
            {
              "$ref": "c1-sku-rights-review-v1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "externalAccesses": {
      "type": "array",
      "maxItems": 0
    },
    "profitRecalculated": {
      "const": false
    },
    "skuReplaced": {
      "const": false
    },
    "finalSeo": {
      "type": "null"
    },
    "finalAttributes": {
      "type": "null"
    },
    "complianceDecision": {
      "type": "null"
    },
    "generatedAssets": {
      "type": "null"
    },
    "productionPayload": {
      "type": "null"
    },
    "factVerificationVersion": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "c1-fact-verification-v1.1",
        "c1-fact-verification-v1.2"
      ]
    },
    "factsVerifiedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "exactSkuVerification": {
      "type": [
        "object",
        "null"
      ]
    },
    "productAttributes": {
      "type": [
        "object",
        "null"
      ]
    },
    "platformCategory": {
      "type": [
        "object",
        "null"
      ]
    },
    "schemaSnapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "batteryAssessment": {
      "type": [
        "object",
        "null"
      ]
    },
    "categoryRestrictions": {
      "type": [
        "object",
        "null"
      ]
    },
    "platformCompliance": {
      "type": [
        "object",
        "null"
      ]
    },
    "seoTitleDraft": {
      "type": [
        "object",
        "null"
      ]
    },
    "descriptionDraft": {
      "type": [
        "object",
        "null"
      ]
    },
    "bulletPointsDraft": {
      "type": [
        "array",
        "null"
      ]
    },
    "searchKeywordsDraft": {
      "type": [
        "object",
        "null"
      ]
    },
    "seoEvidenceLayer": {
      "type": [
        "object",
        "null"
      ]
    },
    "contractVersion": {
      "const": "g1-c1-domain-contract-v1"
    },
    "revisionRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRevision",
        "resultRevision"
      ],
      "properties": {
        "sourceRevision": {
          "type": "integer",
          "minimum": 0
        },
        "resultRevision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "frozenInputRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "skuPackageId",
        "platform",
        "storeRef",
        "sourceRevision",
        "salesSnapshotId",
        "selectedSupplySnapshotId",
        "ownerSupplyConfirmationRef",
        "profitModelVersion",
        "schemaSnapshotRef"
      ],
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "skuPackageId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "platform": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "storeRef": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 0
        },
        "salesSnapshotId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "selectedSupplySnapshotId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "ownerSupplyConfirmationRef": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "profitModelVersion": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "schemaSnapshotRef": {
          "$ref": "#/$defs/canonicalFrozenRef"
        }
      }
    },
    "schemaSnapshotRef": {
      "allOf": [
        {
          "$ref": "#/$defs/opaqueEvidenceRef"
        },
        {
          "$ref": "#/$defs/canonicalFrozenRef"
        }
      ]
    },
    "keywordEvidenceRefs": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/opaqueEvidenceRef"
          },
          {
            "$ref": "#/$defs/canonicalFrozenRef"
          }
        ]
      }
    },
    "draftOnlySeo": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "formalProviderResultAccepted",
            "reason",
            "aiRequestId",
            "aiRequestFingerprint",
            "inputFingerprint",
            "sourceRevision",
            "receiptRef",
            "providerJobRef"
          ],
          "properties": {
            "status": {
              "const": "draft_only"
            },
            "formalProviderResultAccepted": {
              "const": true
            },
            "reason": {
              "type": "null"
            },
            "aiRequestId": {
              "allOf": [
                {
                  "$ref": "#/$defs/opaqueEvidenceRef"
                },
                {
                  "$ref": "#/$defs/canonicalFrozenRef"
                }
              ]
            },
            "aiRequestFingerprint": {
              "$ref": "#/$defs/sha256"
            },
            "inputFingerprint": {
              "$ref": "#/$defs/sha256"
            },
            "sourceRevision": {
              "type": "integer",
              "minimum": 0
            },
            "receiptRef": {
              "allOf": [
                {
                  "$ref": "#/$defs/opaqueEvidenceRef"
                },
                {
                  "$ref": "#/$defs/canonicalFrozenRef"
                }
              ]
            },
            "providerJobRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "jobId",
                "jobType",
                "providerId",
                "providerVersion",
                "candidateId",
                "skuPackageId",
                "platform",
                "storeRef",
                "authorizationRef",
                "inputFingerprint",
                "sourceRevision",
                "receiptRef",
                "terminalStatus",
                "requestSubmitted",
                "responseVerified"
              ],
              "properties": {
                "jobId": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/opaqueEvidenceRef"
                    },
                    {
                      "$ref": "#/$defs/canonicalFrozenRef"
                    }
                  ]
                },
                "jobType": {
                  "const": "c1_ai_draft"
                },
                "providerId": {
                  "allOf": [
                    {
                      "not": {
                        "const": "unknown"
                      }
                    },
                    {
                      "$ref": "#/$defs/canonicalFrozenRef"
                    }
                  ]
                },
                "providerVersion": {
                  "allOf": [
                    {
                      "not": {
                        "const": "unknown"
                      }
                    },
                    {
                      "$ref": "#/$defs/canonicalFrozenRef"
                    }
                  ]
                },
                "candidateId": {
                  "$ref": "#/$defs/canonicalFrozenRef"
                },
                "skuPackageId": {
                  "$ref": "#/$defs/canonicalFrozenRef"
                },
                "platform": {
                  "$ref": "#/$defs/canonicalFrozenRef"
                },
                "storeRef": {
                  "$ref": "#/$defs/canonicalFrozenRef"
                },
                "authorizationRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "authorizationId",
                    "authorizationType",
                    "scope"
                  ],
                  "properties": {
                    "authorizationId": {
                      "$ref": "#/$defs/c1OpaqueAuthorizationId"
                    },
                    "authorizationType": {
                      "const": "paid_ai_draft"
                    },
                    "scope": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "candidateId",
                        "skuPackageId",
                        "platform",
                        "storeRef",
                        "sourceRevision",
                        "jobType"
                      ],
                      "properties": {
                        "candidateId": {
                          "$ref": "#/$defs/canonicalFrozenRef"
                        },
                        "skuPackageId": {
                          "$ref": "#/$defs/canonicalFrozenRef"
                        },
                        "platform": {
                          "$ref": "#/$defs/canonicalFrozenRef"
                        },
                        "storeRef": {
                          "$ref": "#/$defs/canonicalFrozenRef"
                        },
                        "sourceRevision": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "jobType": {
                          "const": "c1_ai_draft"
                        }
                      }
                    }
                  }
                },
                "inputFingerprint": {
                  "$ref": "#/$defs/sha256"
                },
                "sourceRevision": {
                  "type": "integer",
                  "minimum": 0
                },
                "receiptRef": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/opaqueEvidenceRef"
                    },
                    {
                      "$ref": "#/$defs/canonicalFrozenRef"
                    }
                  ]
                },
                "terminalStatus": {
                  "const": "completed"
                },
                "requestSubmitted": {
                  "const": true
                },
                "responseVerified": {
                  "const": true
                }
              }
            },
            "pricingReuseRecord": {
              "$ref": "c1-product-plan-v1.1#/$defs/c1PricingReuseRecord"
            }
          }
        },
        {
          "$ref": "c1-editorial-source-v1.schema.json#/$defs/draftOnlySeo"
        },
        {
          "$ref": "c1-editorial-source-v2.schema.json#/$defs/draftOnlySeo"
        },
        {
          "$ref": "c1-sibling-formal-reuse-v1.schema.json#/$defs/draftOnlySeo"
        }
      ]
    },
    "unknownManifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fieldPath",
          "reason",
          "sourceRefs",
          "blockingScope",
          "blocksC2Handoff"
        ],
        "properties": {
          "fieldPath": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/opaqueEvidenceRef"
            }
          },
          "blockingScope": {
            "enum": [
              "informational",
              "required_field",
              "compliance"
            ]
          },
          "blocksC2Handoff": {
            "type": "boolean"
          }
        }
      }
    },
    "sourceFactsRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "revisionId",
        "targetC1PlanId",
        "sourceC1PlanId",
        "sourceSupplySnapshotId",
        "preparedAt",
        "sourceCandidateRevision",
        "sourceSkuRevision",
        "sourceIdentity",
        "records",
        "sourceCandidate"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            "c1-supplier-fact-revision-v1",
            "c1-supplier-fact-revision-v2"
          ]
        },
        "revisionId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "targetC1PlanId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "sourceC1PlanId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "sourceSupplySnapshotId": {
          "$ref": "#/$defs/canonicalFrozenRef"
        },
        "preparedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceCandidateRevision": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSkuRevision": {
          "type": "integer",
          "minimum": 1
        },
        "sourceIdentity": {
          "type": "object"
        },
        "records": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "label",
              "value",
              "valueZh",
              "status",
              "sourceRefs"
            ],
            "properties": {
              "field": {
                "enum": [
                  "battery",
                  "color",
                  "size",
                  "variant",
                  "brand"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "valueZh": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "status": {
                "const": "confirmed"
              },
              "sourceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "powerProfile": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "containsBattery",
                  "batteryType",
                  "sourceRef"
                ],
                "properties": {
                  "containsBattery": {
                    "type": "boolean"
                  },
                  "batteryType": {
                    "enum": [
                      "none",
                      "installed",
                      "standalone"
                    ]
                  },
                  "sourceRef": {
                    "$ref": "#/$defs/canonicalFrozenRef"
                  }
                }
              }
            }
          }
        },
        "sourceCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "dataRevision",
            "targetPlatform",
            "storeRef",
            "lifecycleV11"
          ],
          "properties": {
            "storeRef": {
              "type": "object"
            },
            "cargoFactsV1": {
              "type": "object"
            },
            "aProductDetailEvidenceV1": {
              "type": "object"
            },
            "sourceCapture": {
              "type": "object"
            },
            "lifecycleV11": {
              "type": "object"
            },
            "salesSnapshotsV11": {
              "type": "array"
            },
            "supplierOptionsV11": {
              "type": "array"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "dataRevision": {
              "type": "integer",
              "minimum": 1
            },
            "targetPlatform": {
              "enum": [
                "ozon",
                "wb"
              ]
            },
            "targetStore": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": "c1-supplier-fact-revision-v1"
              }
            }
          },
          "then": {
            "properties": {
              "records": {
                "minItems": 1,
                "type": "array"
              },
              "sourceCandidate": {
                "properties": {
                  "lifecycleV11": {
                    "not": {
                      "type": "object",
                      "properties": {
                        "ownerProductFactsV1": {}
                      },
                      "required": [
                        "ownerProductFactsV1"
                      ]
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "sourceCandidate": {
                "properties": {
                  "lifecycleV11": {
                    "required": [
                      "ownerProductFactsV1"
                    ],
                    "properties": {
                      "ownerProductFactsV1": {
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "c1OpaqueAuthorizationId": {
      "type": "string",
