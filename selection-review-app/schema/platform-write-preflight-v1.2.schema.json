{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-write-preflight-v1.2",
  "title": "平台写入前置检查 v1.2",
  "type": "object",
  "required": [
    "schemaVersion",
    "preflightId",
    "sourceProductionPlanId",
    "sourceProductionPlanFingerprint",
    "targetPlatform",
    "storeIdentity",
    "permission",
    "connectionStatus",
    "authorizedWriteFields",
    "platformWritableFields",
    "effectiveWritableFields",
    "imagePermission",
    "priceCurrency",
    "risks",
    "technicalStatus",
    "businessStateEffect",
    "checkedAt",
    "readyForPlatformWrite",
    "productCreated",
    "imagesUploaded",
    "inventoryModified",
    "storeDataModified",
    "productionRecordCreated",
    "platformWrites",
    "connectionRequirements"
  ],
  "properties": {
    "schemaVersion": {
      "const": "platform-write-preflight-v1.2"
    },
    "preflightId": {
      "type": "string",
      "minLength": 1
    },
    "sourceProductionPlanId": {
      "type": "string",
      "minLength": 1
    },
    "sourceProductionPlanFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetPlatform": {
      "const": "ozon"
    },
    "storeIdentity": {
      "type": "object",
      "required": [
        "expectedStore",
        "observedStore",
        "status",
        "evidenceRef",
        "expectedStoreRef",
        "observedStoreRef"
      ],
      "properties": {
        "expectedStore": {
          "type": "string",
          "minLength": 1
        },
        "observedStore": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "matched",
            "mismatched",
            "unverified"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "expectedStoreRef": {
          "$ref": "#/$defs/storeRef"
        },
        "observedStoreRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/storeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifiedVia": {
          "description": "身份结论所依据的锚点。scoped_warehouse 表示由仓库反推（主人2026-09-16决定），此时平台不提供店铺编号，observedStoreRef 必须为 null。字段缺失按 platform_store_id 读取。",
          "enum": [
            "platform_store_id",
            "scoped_warehouse",
            "none"
          ]
        }
      },
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "required": [
        "status",
        "evidenceRef"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "denied",
            "permission_required",
            "unknown"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "connectionStatus": {
      "type": "object",
      "required": [
        "api",
        "sellerBackend"
      ],
      "properties": {
        "api": {
          "$ref": "#/$defs/connection"
        },
        "sellerBackend": {
          "$ref": "#/$defs/connection"
        }
      },
      "additionalProperties": false
    },
    "authorizedWriteFields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platformWritableFields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effectiveWritableFields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "imagePermission": {
      "type": "object",
      "required": [
        "status",
        "evidenceRef"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "denied",
            "permission_required",
            "unknown"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "priceCurrency": {
      "type": "object",
      "required": [
        "expected",
        "observed",
        "status",
        "evidenceRef"
      ],
      "properties": {
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "matched",
            "mismatched",
            "unverified"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "technicalStatus": {
      "enum": [
        "completed",
        "system_error",
        "permission_required",
        "data_unavailable"
      ]
    },
    "businessStateEffect": {
      "const": "none"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "readyForPlatformWrite": {
      "const": false
    },
    "productCreated": {
      "const": false
    },
    "imagesUploaded": {
      "const": 0
    },
    "inventoryModified": {
      "const": false
    },
    "storeDataModified": {
      "const": false
    },
    "productionRecordCreated": {
      "const": false
    },
    "platformWrites": {
      "const": 0
    },
    "connectionRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "route",
        "requiredConnections"
      ],
      "properties": {
        "contractVersion": {
          "const": "ozon-connection-requirements-v1"
        },
        "route": {
          "const": "seller_api"
        },
        "requiredConnections": {
          "const": [
            "api"
          ]
        }
      }
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "required": [
        "status",
        "checkedVia",
        "evidenceRef"
      ],
      "properties": {
        "status": {
          "enum": [
            "connected",
            "unavailable",
            "system_error",
            "permission_required",
            "unknown"
          ]
        },
        "checkedVia": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "storeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableStoreId",
        "platformStoreId",
        "mappingVersion"
      ],
      "properties": {
        "stableStoreId": {
          "type": "string",
          "minLength": 1
        },
        "platformStoreId": {
          "type": "string",
          "minLength": 1
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
