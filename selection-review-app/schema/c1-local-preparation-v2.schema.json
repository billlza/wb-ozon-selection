{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1-local-preparation-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "skuPackageId",
    "supplierSkuId",
    "variantKey",
    "variantAttributes",
    "sourceCandidateRevision",
    "resultCandidateRevision",
    "sourceSkuRevision",
    "targetPlatform",
    "targetStore",
    "mode",
    "attributes",
    "keywords",
    "competitorTextSnapshots",
    "reusableKeywordSnapshot",
    "quantityPolicy",
    "writingRules",
    "skillRef",
    "preparationOnly",
    "status",
    "gaps",
    "producedAt",
    "materialFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "c1-local-preparation-v2"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "skuPackageId": {
      "type": "string",
      "minLength": 1
    },
    "supplierSkuId": {
      "type": "string",
      "minLength": 1
    },
    "variantKey": {
      "type": "string",
      "minLength": 1
    },
    "variantAttributes": {
      "type": "object"
    },
    "sourceCandidateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "resultCandidateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "sourceSkuRevision": {
      "type": "integer",
      "minimum": 0
    },
    "targetPlatform": {
      "const": "ozon"
    },
    "targetStore": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "saved_material_only"
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fieldKey",
          "label",
          "required",
          "value",
          "sourceValue",
          "sourceScope",
          "sourceRefs",
          "status"
        ],
        "properties": {
          "fieldKey": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "value": {},
          "sourceValue": {},
          "sourceScope": {
            "enum": [
              "supplier_product",
              "category",
              "sku"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "not_supplied",
              "scope_unresolved",
              "needs_review",
              "dictionary_pending"
            ]
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "purposes",
          "sourceRefs",
          "factPath",
          "evidenceKind",
          "searchVolume",
          "conversion",
          "wordingStatus"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "title",
                "attributes",
                "description"
              ]
            }
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "factPath": {
            "type": "string",
            "minLength": 1
          },
          "evidenceKind": {
            "const": "owner_confirmed_attribute"
          },
          "searchVolume": {
            "type": "null"
          },
          "conversion": {
            "type": "null"
          },
          "wordingStatus": {
            "const": "existing_platform_wording"
          }
        }
      }
    },
    "competitorTextSnapshots": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshotId",
          "title",
          "collectedAt",
          "sourceRef",
          "role",
          "adoptedAsProductFact"
        ],
        "properties": {
          "snapshotId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "const": "buyer_language_reference_only"
          },
          "adoptedAsProductFact": {
            "const": false
          }
        }
      }
    },
    "reusableKeywordSnapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "quantityPolicy": {
      "const": {
        "titleMinimum": 1,
        "tagMinimum": 0,
        "longTailMinimum": 0,
        "fixedTotal": null
      }
    },
    "writingRules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skillRef": {
      "const": "optimize-ecommerce-seo"
    },
    "preparationOnly": {
      "const": true
    },
    "status": {
      "enum": [
        "ready_for_review",
        "needs_information"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "field",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "materialFingerprint": {
      "type": "string",
      "minLength": 1
    }
  }
}
