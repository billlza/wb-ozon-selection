{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d-platform-observation-v1.schema.json",
  "title": "One bounded read of the original D task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateId",
    "skuPackageId",
    "supplierSkuId",
    "sourceDJobId",
    "sourceExecutionKey",
    "authorizationRef",
    "requestReceiptRef",
    "warehouseRef",
    "credentialAlias",
    "schemaVersion",
    "revision",
    "authorizationFingerprint",
    "inputFingerprint",
    "taskId",
    "warehouseId",
    "platform",
    "store",
    "storeRef",
    "productionBinding",
    "queryIndex",
    "queryKind",
    "nextEligibleAt",
    "policy"
  ],
  "properties": {
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "skuPackageId": {
      "type": "string",
      "minLength": 1
    },
    "supplierSkuId": {
      "type": "string",
      "minLength": 1
    },
    "sourceDJobId": {
      "type": "string",
      "minLength": 1
    },
    "sourceExecutionKey": {
      "type": "string",
      "minLength": 1
    },
    "authorizationRef": {
      "$ref": "software-job-v1.schema.json#/$defs/deOpaqueSourceRef"
    },
    "requestReceiptRef": {
      "type": "string",
      "minLength": 1
    },
    "warehouseRef": {
      "type": "string",
      "minLength": 1
    },
    "credentialAlias": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "d-platform-observation-scope-v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "authorizationFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "warehouseId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "platform": {
      "const": "ozon"
    },
    "store": {
      "type": "string",
      "minLength": 1
    },
    "storeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableStoreId",
        "platformStoreId",
        "mappingVersion"
      ],
      "properties": {
        "stableStoreId": {
          "$ref": "#/$defs/strictRef"
        },
        "platformStoreId": {
          "$ref": "#/$defs/strictRef"
        },
        "mappingVersion": {
          "$ref": "#/$defs/strictRef"
        }
      }
    },
    "productionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "configurationVersion",
        "warehouseId"
      ],
      "properties": {
        "bindingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,160}$"
        },
        "configurationVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,160}$"
        },
        "warehouseId": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991)$"
        }
      }
    },
    "queryIndex": {
      "type": "integer",
      "minimum": 1
    },
    "queryKind": {
      "enum": [
        "import_task",
        "price_state",
        "inventory_prerequisites"
      ]
    },
    "nextEligibleAt": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyRef",
        "version",
        "maxQueries",
        "intervalMs",
        "expiresAt",
        "requestTimeoutMs"
      ],
      "properties": {
        "schemaVersion": {
          "const": "d-platform-observation-policy-v1"
        },
        "policyRef": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "maxQueries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "deSourceRef": {
      "allOf": [
        {
          "$ref": "c1-ai-draft-request-v1#/$defs/canonicalFrozenRef"
        },
        {
          "$ref": "#/$defs/deNonPlaceholderRef"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "strictRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.{1,256}$)(?!.*[\\u0000-\\u001f\\s?#@=&\\\\])(?!(?:[Ff][Ii][Ll][Ee]:|[Hh][Tt][Tt][Pp][Ss]?:|/|\\\\|[A-Za-z]:[\\\\/]))(?!.*//)[A-Za-z0-9][A-Za-z0-9._:~-]*$"
    },
    "deNonPlaceholderRef": {
      "type": "string",
      "not": {
        "pattern": "^(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Nn][Uu][Ll][Ll]|[Uu][Nn][Dd][Ee][Ff][Ii][Nn][Ee][Dd]|[Nn][Oo][Tt]_[Aa][Pp][Pp][Ll][Ii][Cc][Aa][Bb][Ll][Ee]|[Mm][Ii][Ss][Ss][Ii][Nn][Gg])$"
      }
    }
  }
}
