{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "全店经营工作台 · 商品只读采集器",
  "version": "1.3.0",
  "description": "仅领取本机全店经营工作台明确建立的单候选只读作业，读取1688、拼多多或Ozon商品页结构化证据，或用拼多多首图在1688搜一次图并回传到127.0.0.1:4317。",
  "permissions": [
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://qr.1688.com/s/*",
    "https://detail.1688.com/offer/*",
    "https://mobile.yangkeduo.com/*",
    "https://mobile.pinduoduo.com/*",
    "https://p.pinduoduo.com/*",
    "https://www.ozon.ru/product/*",
    "https://s.1688.com/youyuan/*",
    "https://air.1688.com/kapp/*",
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:4317/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "全店经营工作台 · 商品只读采集器"
  }
}
